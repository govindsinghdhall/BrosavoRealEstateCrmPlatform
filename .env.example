# Local dev — Vite proxies /api to RealEstateBackend on :4000
VITE_API_BASE_URL=/api/v1

# Production backend
# VITE_API_BASE_URL=https://api.brosavo.com/api/v1

# ---------------------------------------------------------------------------
# Meta WhatsApp Embedded Signup (Vite browser env — VITE_ prefix required)
#
# These are public client identifiers, not secrets.
# Never put App Secret, System User tokens, or permanent access tokens here.
#
# Production (Vercel) must define the same three variables for crm.brosavo.com.
# ---------------------------------------------------------------------------
VITE_META_APP_ID=your_meta_app_id
VITE_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=your_embedded_signup_config_id
VITE_META_GRAPH_API_VERSION=v26.0
